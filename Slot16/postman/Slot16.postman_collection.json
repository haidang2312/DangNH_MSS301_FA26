  "item": [
    {
      "name": "Create active creator",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/users",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"creator_{{$timestamp}}\",\n  \"email\": \"creator@example.com\",\n  \"role\": \"CREATOR\",\n  \"ratePerPost\": 500000,\n  \"maxDailyPosts\": 3,\n  \"level\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"status 1\", () => pm.expect(pm.response.json().status).to.eql(1));",
              "pm.test(\"ISO timestamp\", () => pm.expect(Date.parse(pm.response.json().timestamp)).not.to.be.NaN);",
              "pm.collectionVariables.set(\"userId\", pm.response.json().data.userId);",
              "pm.collectionVariables.set(\"username\", pm.response.json().data.username);"
            ]
          }
        }
      ]
    },
