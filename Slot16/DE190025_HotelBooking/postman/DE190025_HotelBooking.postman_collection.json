  "item": [
    {
      "name": "Create available room",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/rooms",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"roomNumber\": \"R-{{$timestamp}}\",\n  \"roomType\": \"DOUBLE\",\n  \"pricePerNight\": 850000,\n  \"capacity\": 2,\n  \"floor\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\",()=>pm.response.to.have.status(201));",
              "pm.test(\"status 1\",()=>pm.expect(pm.response.json().status).to.eql(1));",
              "pm.test(\"timestamp\",()=>pm.expect(Date.parse(pm.response.json().timestamp)).not.to.be.NaN);",
              "pm.collectionVariables.set(\"roomId\",pm.response.json().data.roomId);",
              "pm.collectionVariables.set(\"roomNumber\",pm.response.json().data.roomNumber);",
              "pm.test(\"available default\",()=>pm.expect(pm.response.json().data.status).to.eql(\"AVAILABLE\"));"
            ]
          }
        }
      ]
    },
