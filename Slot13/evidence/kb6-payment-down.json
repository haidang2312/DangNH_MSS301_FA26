            "script": {
              "id": "bec17bba-685c-473f-be65-065fb6308ecc",
              "type": "text/javascript",
              "exec": [
                "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
                "const o=pm.response.json();pm.collectionVariables.set('kb6OrderId',o.id);",
                "pm.test('order status',()=>pm.expect(o.status).to.eql('CANCELLED'));",
                "pm.test('saga status',()=>pm.expect(o.sagaStatus).to.eql('COMPENSATED'));",
                "pm.test('failure reason',()=>pm.expect(o.failureReason).to.match(/^Service/));"
              ],
              "_lastExecutionId": "259ebe71-e051-477c-872b-5754ee7c9afd"
