    {
      "name": "KB1 - Happy path",
      "item": [
        {
          "name": "1. Snapshot",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{inventoryUrl}}/api/inventory/products"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
                  "pm.response.json().forEach(p=>pm.collectionVariables.set('stock_'+p.id,p.stock));",
                  "pm.sendRequest(pm.collectionVariables.get('paymentUrl')+'/api/payments/wallets',(e,r)=>{pm.test('read wallets',()=>pm.expect(e).to.be.null);r.json().forEach(w=>pm.collectionVariables.set('bal_'+w.customerId,w.balance));});"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Place order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{orderUrl}}/api/orders",
            "body": {
              "mode": "raw",
              "raw": "{\"customerId\": \"C1\", \"productId\": \"P1\", \"quantity\": 2, \"amount\": 2000}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
                  "const o=pm.response.json();pm.collectionVariables.set('kb1OrderId',o.id);",
                  "pm.test('order status',()=>pm.expect(o.status).to.eql('CONFIRMED'));",
                  "pm.test('saga status',()=>pm.expect(o.sagaStatus).to.eql('COMPLETED'));",
                  "pm.test('no failure',()=>pm.expect(o.failureReason).to.be.null);"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Check balances",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{inventoryUrl}}/api/inventory/products"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
                  "const stock={\"P1\": -2}, bal={\"C1\": -2000};",
                  "pm.response.json().forEach(p=>pm.test('stock '+p.id,()=>pm.expect(p.stock).to.eql(Number(pm.collectionVariables.get('stock_'+p.id))+(stock[p.id]||0))));",
                  "pm.sendRequest(pm.collectionVariables.get('paymentUrl')+'/api/payments/wallets',(e,r)=>{pm.test('read wallets',()=>pm.expect(e).to.be.null);r.json().forEach(w=>pm.test('balance '+w.customerId,()=>pm.expect(w.balance).to.eql(Number(pm.collectionVariables.get('bal_'+w.customerId))+(bal[w.customerId]||0))));});"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Saga logs",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{orderUrl}}/api/orders/{{kb1OrderId}}/saga-logs"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
                  "pm.test('step order',()=>pm.expect(pm.response.json().map(l=>l.step)).to.eql([\"CREATE_ORDER\", \"RESERVE_INVENTORY\", \"PROCESS_PAYMENT\", \"CONFIRM_ORDER\"]));"
                ]
              }
            }
          ]
        }
      ]
    },
